# ── 运行时数据：绝不入库（里面有真实数据）──
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak

# ── 依赖（node_modules 不入库；要「双击即用」请下载 Releases 里的离线包）──
node_modules/
build/
# 注：dist/ 现在入库了 —— 仓库里直接带编译产物，clone 下来不必自己编译

# ── 便携 Node 运行时（体积大，不进仓库；需要离线包的人自己放）──
node/

# ── 日志 / 临时文件 ──
*.log
out.txt
shot.png
_shots/
_shots2/

# ── 编辑器 / 系统 ──
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__/
*.pyc

# 备份/临时文件（别进仓库）
*.bak.*
*.orig
*.tmp
*~

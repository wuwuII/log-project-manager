// LPM — 日志与项目管理系统 · 数据库模型（SQLite）
// 说明：SQLite 不支持 @db.Uuid / @db.VarChar，Json 一律用 String 存 JSON 文本

generator client {
  provider      = "prisma-client-js"
  // native = 本机（Linux，开发自测用）
  // windows = 目标机（Windows 离线包用，必须一起生成，否则拷过去跑不起来）
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 工作表元数据（永久工作表栏的数据源）
model TableMeta {
  id         String    @id @default(uuid())
  name       String
  type       String    @default("log") // log | project | people
  config     String    @default("{}")
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("tables_meta")
}

/// 日志条目（周日历里每一天一格）
model LogEntry {
  id         String   @id @default(uuid())
  table_id   String
  entry_date String // YYYY-MM-DD
  content    String   @default("")
  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([table_id, entry_date])
  @@index([table_id, entry_date])
  @@map("log_entries")
}

/// 待办
model Todo {
  id                String    @id @default(uuid())
  table_id          String
  title             String
  assignee_id       String?
  points            Int       @default(0)
  status            String    @default("pending") // pending | done
  record_time       DateTime  @default(now())
  completed_at      DateTime?
  sort_order        Int       @default(0)
  linked_project_id String?
  linked_task_id    String?
  transferred       Boolean   @default(false)
  note              String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  deleted_at        DateTime?

  @@index([table_id, status])
  @@map("todos")
}

/// 项目
model Project {
  id          String    @id @default(uuid())
  table_id    String
  name        String
  description String?
  start_date  String?
  end_date    String?
  status      String    @default("active") // active | done | paused
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?

  @@map("projects")
}

/// 项目任务（含计划/实际/进度/积分）
model ProjectTask {
  id            String    @id @default(uuid())
  project_id    String
  parent_id     String?
  name          String
  plan_start    String?
  plan_duration Int       @default(1)
  plan_end      String?
  actual_start  String?
  actual_end    String?
  progress      Int       @default(0)
  assignee_id   String?
  points        Int       @default(0)
  earned_points Float     @default(0)
  status        String    @default("not_started") // not_started | in_progress | done | delayed
  sort_order    Int       @default(0)
  note          String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  @@index([project_id])
  @@map("project_tasks")
}

/// 人员
model Person {
  id           String    @id @default(uuid())
  name         String
  role         String?
  color        String?
  total_points Float     @default(0)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  deleted_at   DateTime?

  @@map("people")
}

/// 积分流水（唯一的积分真相来源）
model PointsLedger {
  id          String   @id @default(uuid())
  person_id   String
  person_name String?
  source_type String // todo | project_task | manual
  source_id   String?
  points      Float
  reason      String?
  created_at  DateTime @default(now())

  @@index([person_id])
  @@map("points_ledger")
}

/// 操作历史（可追溯、可回滚的依据）
model ChangeHistory {
  id         String   @id @default(uuid())
  table_id   String?
  record_id  String?
  entity     String?
  action     String // create | update | delete | complete
  before     String?
  after      String?
  changed_by String?
  created_at DateTime @default(now())

  @@index([table_id, created_at])
  @@map("change_history")
}

/// 提醒（日志页格子里的"提前写好的文字"）
///   repeat: once | weekly | monthly | yearly
///   rule  : JSON 文本，随 repeat 变化
///           once    → {"date":"2026-10-15"}
///           weekly  → {"weekdays":[1,3,5]}          （1=周一 … 7=周日）
///           monthly → {"days":[1,15]}                （每月几号）
///           yearly  → {"dates":[{"month":10,"day":8}]}
///   start_date / end_date：生效范围（含两端；为空=不限）
model Reminder {
  id         String    @id @default(uuid())
  table_id   String
  text       String
  repeat     String    @default("once")
  rule       String    @default("{}")
  start_date String?
  end_date   String?
  enabled    Boolean   @default(true)
  color      String?
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@index([table_id])
  @@map("reminders")
}

/// 导入导出任务记录
model ImportExportJob {
  id         String   @id @default(uuid())
  kind       String // import | export
  status     String   @default("done")
  detail     String?
  created_at DateTime @default(now())

  @@map("import_export_jobs")
}
